                    color: isActive ? '#FFFFFF' : '#334155',
                    fontSize: '14px',
                    fontWeight: 700,
                    cursor: 'pointer',
                    transition: 'all 0.2s ease',
                    boxShadow: isActive ? '0 4px 14px rgba(15, 81, 50, 0.2)' : 'none',
                  }}
                >
                  {lvl.label}
                </button>
              );
            })}
          </div>

          {/* Curriculum Subjects Grid */}
          <div
            style={{
              background: '#FFFFFF',
              borderRadius: '20px',
