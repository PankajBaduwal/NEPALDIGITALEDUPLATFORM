                      <div style={{ fontSize: '11px', color: '#D97706', fontWeight: 600, marginTop: '8px' }}>{sub.hours}</div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {activeGradeLevel === 'higher_sec' && (
              <div>
                <div style={{ marginBottom: '20px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <h4 style={{ fontSize: '20px', fontWeight: 800, color: '#0F172A' }}>Higher Secondary (Classes 11 & 12 - NEB Board)</h4>
                  <span style={{ background: '#F5F3FF', color: '#7C3AED', padding: '4px 10px', borderRadius: '6px', fontSize: '12px', fontWeight: 700 }}>
                    National Examination Board (NEB) Streams
                  </span>
                </div>
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '16px' }}>
                  {[
                    { code: 'NEP11', name: 'Compulsory Nepali', nepName: 'अनिवार्य नेपाली (११/१२)', hours: '3 Credit Hours' },
                    { code: 'ENG11', name: 'Compulsory English', nepName: 'अनिवार्य अंग्रेजी (११/१२)', hours: '4 Credit Hours' },
                    { code: 'SCI-PHY', name: 'Physics (Science Stream)', nepName: 'भौतिकशास्त्र (थ्योरी + ल्याब)', hours: '5 Credit Hours' },
                    { code: 'SCI-CHM', name: 'Chemistry (Science Stream)', nepName: 'रसायनशास्त्र (थ्योरी + ल्याब)', hours: '5 Credit Hours' },
                    { code: 'SCI-BIO', name: 'Biology / Mathematics', nepName: 'जीवविज्ञान वा गणित', hours: '5 Credit Hours' },
                    { code: 'MGT-ACC', name: 'Accountancy (Management)', nepName: 'लेखाविधि सिद्धान्त', hours: '5 Credit Hours' },
                    { code: 'MGT-ECO', name: 'Economics / Business Studies', nepName: 'अर्थशास्त्र / व्यापार अध्ययन', hours: '5 Credit Hours' },
                    { code: 'LAW-JUR', name: 'Jurisprudence / Human Rights', nepName: 'कानून तथा न्यायशास्त्र', hours: '5 Credit Hours' },
                  ].map((sub, idx) => (
                    <div key={idx} style={{ background: '#F8FAFC', borderRadius: '12px', padding: '16px', border: '1px solid #E2E8F0' }}>
                      <span style={{ fontSize: '11px', fontWeight: 800, color: '#7C3AED', background: '#F5F3FF', padding: '2px 6px', borderRadius: '4px' }}>
                        {sub.code}
                      </span>
                      <div style={{ fontSize: '14.5px', fontWeight: 800, color: '#0F172A', marginTop: '8px' }}>{sub.name}</div>
                      <div style={{ fontSize: '13px', color: '#64748B', marginTop: '2px' }}>{sub.nepName}</div>
                      <div style={{ fontSize: '11px', color: '#7C3AED', fontWeight: 600, marginTop: '8px' }}>{sub.hours}</div>
                    </div>
                  ))}
