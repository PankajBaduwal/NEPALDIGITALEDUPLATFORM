                    { code: 'SOC10', name: 'Social Studies', nepName: 'सामाजिक अध्ययन (कोड: ०१७)', hours: '5 Periods/wk' },
                    { code: 'OPT-I', name: 'Optional Mathematics / Env', nepName: 'ऐच्छिक प्रथम: ऐच्छिक गणित / वातावरण', hours: '4 Periods/wk' },
                    { code: 'OPT-II', name: 'Computer Science / Accountancy', nepName: 'ऐच्छिक द्वितीय: कम्प्युटर / लेखा', hours: '4 Periods/wk' },
                    { code: 'PRA10', name: 'Continuous Assessment (CAS)', nepName: 'प्रयोगात्मक २५ अंक मूल्यांकन', hours: 'Internal Continuous' },
