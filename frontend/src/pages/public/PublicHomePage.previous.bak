              { id: 'smartboard', label: '1. Smart Board & Digital Whiteboard', icon: MonitorPlay },
              { id: 'assignment', label: '2. 8-Step Assignment Studio', icon: ClipboardCheck },
              { id: 'quiz', label: '3. Quiz & Anti-Cheat Examination', icon: CheckSquare },
              { id: 'student', label: '4. Student Portal & CDC Textbooks', icon: BookOpen },
              { id: 'admin', label: '5. Principal & School Operations', icon: LayoutDashboard },
            ].map((tab) => {
              const Icon = tab.icon;
              const isActive = activeTab === tab.id;
              return (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id as any)}
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    gap: '8px',
                    padding: '12px 20px',
                    borderRadius: '12px',
                    border: isActive ? '2px solid #047857' : '1.5px solid #CBD5E1',
                    background: isActive ? '#047857' : '#FFFFFF',
                    color: isActive ? '#FFFFFF' : '#334155',
                    fontSize: '14px',
                    fontWeight: 700,
                    cursor: 'pointer',
                    transition: 'all 0.2s ease',
                    boxShadow: isActive ? '0 6px 16px rgba(15, 81, 50, 0.25)' : 'none',
                  }}
                >
                  <Icon size={17} />
                  <span>{tab.label}</span>
                </button>
              );
            })}
