                    { code: 'ENG10', name: 'Compulsory English', nepName: 'अनिवार्य अंग्रेजी (कोड: ००३)', hours: '5 Periods/wk' },
                    { code: 'MTH10', name: 'Compulsory Mathematics', nepName: 'अनिवार्य गणित (कोड: ०११)', hours: '5 Periods/wk' },
