                      style={{ width: '100%', height: '260px', objectFit: 'cover', display: 'block' }}
                      onError={(e) => {
                        (e.target as HTMLImageElement).src = '/assets/brand/nepal_classroom_smartboard_students.jpg';
                      }}
                    />
