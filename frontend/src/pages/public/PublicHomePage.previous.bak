      {/* ── 7. NEPAL CDC CURRICULUM SHOWCASE (CLASS 1–12 DUAL MEDIUM) ─────────── */}
      <section id="curriculum" style={{ padding: '80px 24px', background: '#F8FAFC', borderTop: '1px solid #E2E8F0' }}>
        <div style={{ maxWidth: '1320px', margin: '0 auto' }}>
          <div style={{ textAlign: 'center', marginBottom: '40px' }}>
            <span
              style={{
                background: '#ECFDF5',
                color: '#047857',
                padding: '5px 14px',
                borderRadius: '20px',
                fontSize: '12px',
                fontWeight: 800,
                letterSpacing: '0.5px',
                textTransform: 'uppercase',
                display: 'inline-block',
                marginBottom: '8px',
              }}
            >
              Official National Syllabus
            </span>
            <h2 style={{ fontSize: '34px', fontWeight: 900, color: '#0F172A' }}>
              Nepal CDC Curriculum (Class 1–12)
            </h2>
            <p style={{ fontSize: '16px', color: '#64748B', maxWidth: '640px', margin: '8px auto 0' }}>
              Pre-structured according to the national syllabus framework with bilingual content, credit-hour quotas, and terminal mark weights.
            </p>
          </div>

          {/* Level Switcher */}
          <div style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '32px', flexWrap: 'wrap' }}>
            {[
              { id: 'primary', label: 'Primary Level (Grades 1–5)', desc: 'Foundational literacy & numeracy' },
              { id: 'lower_sec', label: 'Lower Secondary (Grades 6–8)', desc: 'Integrated science & human values' },
              { id: 'secondary', label: 'Secondary (Grades 9–10 SEE)', desc: 'SEE board preparation' },
              { id: 'higher_sec', label: 'Higher Secondary (Grades 11–12 NEB)', desc: 'Science, Management & Law' },
            ].map((lvl) => {
              const isActive = activeGradeLevel === lvl.id;
              return (
                <button
                  key={lvl.id}
                  onClick={() => setActiveGradeLevel(lvl.id as any)}
                  style={{
                    padding: '12px 22px',
                    borderRadius: '12px',
                    border: isActive ? '2px solid #047857' : '1.5px solid #CBD5E1',
