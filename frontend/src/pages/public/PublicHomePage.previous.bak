      {/* ── 11. PROFESSIONAL EDUCATIONAL FOOTER ───────────────────────────────── */}
      <footer id="footer" style={{ background: '#0F172A', color: '#94A3B8', padding: '64px 24px 32px' }}>
        <div style={{ maxWidth: '1320px', margin: '0 auto' }}>
          <div style={{ display: 'grid', gridTemplateColumns: '1.4fr 1fr 1fr 1fr', gap: '40px', marginBottom: '48px' }}>
            {/* Column 1: Brand Info */}
            <div>
              <div style={{ marginBottom: '18px' }}>
                <NepalEduLogo size="md" variant="white" />
              </div>
              <p style={{ fontSize: '13.5px', lineHeight: 1.6, color: '#94A3B8', maxWidth: '340px', marginBottom: '18px' }}>
                The official national digital education operating system for schools and colleges across all 77 districts of Nepal. Fully compliant with Ministry of Education, Science & Technology (MoEST) and Curriculum Development Centre (CDC).
              </p>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', fontSize: '12px', color: '#64748B' }}>
                <div>📍 Sanothimi, Bhaktapur & Singha Durbar, Kathmandu, Nepal</div>
                <div>🔒 256-Bit TLS Encryption • ISO 27001 Data Security</div>
                <div>🇳🇵 National EMIS Compliant (Format 5700XXXXX)</div>
              </div>
            </div>

            {/* Column 2: Dedicated Portals */}
            <div>
              <h4 style={{ fontSize: '14px', fontWeight: 800, color: '#FFFFFF', textTransform: 'uppercase', letterSpacing: '0.5px', marginBottom: '18px' }}>
                Role Portals
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '11px', fontSize: '13px' }}>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Principal Portal</Link>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>School Admin Portal</Link>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Class Teacher Workspace</Link>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Subject Faculty Portal</Link>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Student Learning Center</Link>
                <Link to="/super-admin-login" style={{ color: '#34D399', textDecoration: 'none', fontWeight: 700 }}>
                  Super Admin (MoEST)
                </Link>
              </div>
            </div>

            {/* Column 3: CDC Curriculum */}
            <div>
              <h4 style={{ fontSize: '14px', fontWeight: 800, color: '#FFFFFF', textTransform: 'uppercase', letterSpacing: '0.5px', marginBottom: '18px' }}>
                CDC Curriculum
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '11px', fontSize: '13px' }}>
                <span style={{ color: '#94A3B8' }}>Primary (Classes 1–5)</span>
                <span style={{ color: '#94A3B8' }}>Basic Level (Classes 6–8 BLE)</span>
                <span style={{ color: '#94A3B8' }}>Secondary (Classes 9–10 SEE)</span>
                <span style={{ color: '#94A3B8' }}>Higher Secondary (Classes 11–12 NEB)</span>
                <a
                  href="/smartboard/index.html"
                  target="_blank"
                  rel="noreferrer"
                  style={{ color: '#38BDF8', textDecoration: 'none', fontWeight: 600, display: 'inline-flex', alignItems: 'center', gap: '4px' }}
                >
                  <span>Smart Board Studio</span>
                  <ExternalLink size={12} />
                </a>
              </div>
            </div>

            {/* Column 4: Institutions */}
            <div>
              <h4 style={{ fontSize: '14px', fontWeight: 800, color: '#FFFFFF', textTransform: 'uppercase', letterSpacing: '0.5px', marginBottom: '18px' }}>
                Institutions
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '11px', fontSize: '13px' }}>
                <Link to="/register" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Register New School / College</Link>
                <Link to="/institution-registration-status" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Check Registration Status</Link>
                <button
                  onClick={() => setDemoModalOpen(true)}
                  style={{
                    background: 'none',
                    border: 'none',
                    padding: 0,
                    color: '#34D399',
                    fontWeight: 700,
                    textAlign: 'left',
                    cursor: 'pointer',
                    fontSize: '13px',
                  }}
                >
                  ⚡ Interactive Demo Ecosystem
                </button>
                <Link to="/login" style={{ color: '#CBD5E1', textDecoration: 'none' }}>Institution Portal Login</Link>
              </div>
            </div>
          </div>

          {/* Bottom Copyright & Legal */}
          <div
            style={{
              borderTop: '1px solid #1E293B',
              paddingTop: '24px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              flexWrap: 'wrap',
              gap: '12px',
              fontSize: '12px',
              color: '#64748B',
            }}
          >
            <div>
              © 2083 / 2026 Nepal Digital Education Platform. All rights reserved. Government of Nepal Standard.
            </div>
            <div style={{ display: 'flex', gap: '20px' }}>
              <span style={{ cursor: 'pointer' }}>Privacy Policy</span>
              <span style={{ cursor: 'pointer' }}>Terms of Academic Service</span>
              <span style={{ cursor: 'pointer' }}>MoEST Guidelines</span>
            </div>
          </div>
        </div>
      </footer>

      {/* Live Demo Role Modal */}
      <DemoRoleModal isOpen={demoModalOpen} onClose={() => setDemoModalOpen(false)} />

      {/* Demo Video Modal */}
      {showVideoModal && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0,0,0,0.75)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 100,
            padding: '20px',
          }}
          onClick={() => setShowVideoModal(false)}
        >
          <div
            style={{
              background: '#FFFFFF',
              borderRadius: '20px',
              maxWidth: '720px',
              width: '100%',
              padding: '24px',
              position: 'relative',
              boxShadow: '0 25px 50px rgba(0,0,0,0.3)',
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                <MonitorPlay size={22} color="#047857" />
                <h3 style={{ fontSize: '18px', fontWeight: 800, color: '#0F172A' }}>
                  Nepal Digital Education Platform Tour
                </h3>
              </div>
              <button
                onClick={() => setShowVideoModal(false)}
                style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#64748B' }}
              >
                <X size={20} />
              </button>
            </div>
            <div
              style={{
                background: '#F8FAFC',
                borderRadius: '14px',
                padding: '20px',
                textAlign: 'center',
                marginBottom: '16px',
                border: '1px solid #E2E8F0',
              }}
            >
              <img
                src="/assets/brand/online_smartboard_lecture.jpg"
                alt="Smart Board Classroom Session"
                style={{
                  width: '100%',
                  maxHeight: '280px',
                  objectFit: 'cover',
                  borderRadius: '10px',
                  marginBottom: '16px',
                }}
              />
              <h4 style={{ fontSize: '17px', fontWeight: 800, color: '#0F172A', marginBottom: '6px' }}>
                Smart Board, CDC Textbooks & AI Assessment Tour
              </h4>
              <p style={{ fontSize: '13.5px', color: '#64748B', maxWidth: '520px', margin: '0 auto 18px', lineHeight: 1.5 }}>
                Interactive digital whiteboard with dual-pane CDC textbooks, OCR handwriting evaluation, and conflict-free timetable scheduling.
              </p>
              <div style={{ display: 'flex', justifyContent: 'center', gap: '10px' }}>
                <button
                  onClick={() => {
                    setShowVideoModal(false);
                    setDemoModalOpen(true);
                  }}
                  style={{
                    padding: '11px 22px',
                    borderRadius: '8px',
                    background: '#047857',
                    color: '#FFFFFF',
                    fontSize: '13.5px',
                    fontWeight: 700,
                    border: 'none',
                    cursor: 'pointer',
                  }}
                >
                  Experience Live Demo Now →
                </button>
                <button
                  onClick={() => window.open('/smartboard/index.html', '_blank')}
                  style={{
                    padding: '11px 18px',
                    borderRadius: '8px',
                    background: '#FFFFFF',
                    color: '#0F172A',
                    fontSize: '13.5px',
                    fontWeight: 700,
                    border: '1.5px solid #CBD5E1',
                    cursor: 'pointer',
                  }}
                >
                  Open Smart Board
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default PublicHomePage;
