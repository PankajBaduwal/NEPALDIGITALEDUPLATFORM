# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nepal_edu_ecosystem
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SMARTBOARD_PATH=../smartboard
NEPAL_DATA_PATH=../Nepal data

# Gemini (server-side only — never expose to the browser, never use a VITE_ prefix)
GEMINI_API_KEY=your-rotated-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Outgoing email for password-reset links (leave SMTP_HOST empty to disable sending)
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nepal Education Platform <no-reply@your-domain.example>

# Guardian absence SMS (leave SMS_PROVIDER empty to only prepare messages). Providers: sparrow | webhook
SMS_PROVIDER=
SMS_TOKEN=
SMS_SENDER=
SMS_API_URL=
